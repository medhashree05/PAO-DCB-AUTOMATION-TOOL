{
  "name": "pao-downloader",
  "version": "1.0.0",
  "description": "PAO Excel Downloader - Standalone Executable",
  "author": "",
  "license": "ISC",

  "bin": "server.js",

  "scripts": {
    "start": "node server.js",
    "build:exe": "pkg . --out-path dist"
  },

  "pkg": {
    "scripts": [
      "server.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "assets": []
  },

  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "puppeteer": "^24.33.0"
  },

  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4"
  }
}
